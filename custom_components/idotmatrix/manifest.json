{
  "domain": "idotmatrix",
  "name": "iDotMatrix",
  "bluetooth": [
    {
      "local_name": "IDM-*",
      "connectable": true
    }
  ],
  "codeowners": ["@markusressel"],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters", "http", "media_source"],
  "documentation": "https://github.com/markusressel/ha-idotmatrix",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/markusressel/ha-idotmatrix/issues",
  "loggers": ["idotmatrix"],
  "requirements": ["idotmatrix-api-client==1.1.0"],
  "version": "1.1.0"
}
