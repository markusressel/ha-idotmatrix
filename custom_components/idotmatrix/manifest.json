{
  "domain": "idotmatrix",
  "name": "iDotMatrix",
  "bluetooth": [
    {
      "local_name": "IDM-*",
      "connectable": true
    }
  ],
  "codeowners": ["@markusressel"],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters"],
  "documentation": "https://github.com/markusressel/ha-idotmatrix",
  "integration_type": "device",
  "iot_class": "local_push",
  "issue_tracker": "https://github.com/markusressel/ha-idotmatrix/issues",
  "loggers": ["idotmatrix"],
  "requirements": ["idotmatrix-api-client==0.2.1"],
  "version": "0.1.0"
}
